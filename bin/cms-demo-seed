#!/usr/bin/env php
<?php

declare(strict_types=1);

require dirname(__DIR__) . '/dizge.php';

use Dizge\Cms\ContentRepository;

if (($argv[1] ?? '') !== 'ka-teknoloji') {
    fwrite(STDERR, "Usage: php bin/cms-demo-seed ka-teknoloji\n");
    exit(2);
}

$authorId = (int) db()->pdo()->query('SELECT id FROM users WHERE role = "admin" ORDER BY id LIMIT 1')->fetchColumn();
if ($authorId < 1) {
    fwrite(STDERR, "Create an administrator before installing a demo seed.\n");
    exit(1);
}
$repo = new ContentRepository(db());
if ($repo->slugExists('ka-teknoloji-danismanlik')) {
    echo "KA Teknoloji example is already installed.\n";
    exit(0);
}
$repo->create([
    'type' => 'service', 'title' => 'KA Teknoloji danışmanlık', 'slug' => 'ka-teknoloji-danismanlik',
    'body_html' => '<p>Örnek hizmet içeriği. Kendi tema ve içeriğinizle değiştirebilirsiniz.</p>',
    'blocks_json' => '[{"type":"hero","data":{"title":"KA Teknoloji danışmanlık","summary":"Opsiyonel referans uygulama verisi"}}]',
    'meta_description' => 'DizgeCMS için opsiyonel KA Teknoloji örnek hizmeti.', 'author_id' => $authorId,
]);
echo "KA Teknoloji example installed.\n";
