DIZGE_DEBUG=0
DIZGE_ENV=production
DIZGECMS_SITE_URL=https://dizgecms.digitaltamam.com
DIZGECMS_THEME=starter
# Required in production. Generate a long random value; preview links will not boot without it.
DIZGECMS_PREVIEW_SECRET="replace-with-a-long-random-secret"
# Contact form submissions are retained for this many days (1–365), then purged automatically.
DIZGECMS_CONTACT_RETENTION_DAYS=30
# Optional comma-separated HTTPS origins allowed to read anonymous headless API responses.
# DIZGECMS_PUBLIC_ORIGINS="https://www.example.test"
# DIZGE_MAIL_FROM="noreply@example.test"
# Only needed behind a TLS-terminating reverse proxy (e.g. Nginx on the same host). Comma-separated
# CIDR ranges of the proxy's own address(es); DizgePHP then trusts X-Forwarded-For/-Proto from that
# peer only, for the Secure cookie flag and for rate-limit IP keying. Never set this to "0.0.0.0/0".
# DIZGE_TRUSTED_PROXIES="127.0.0.1/32,::1/128"
# Forces the session cookie's Secure flag regardless of HTTPS detection; set "0" to force it off
# during local HTTP development if DIZGE_TRUSTED_PROXIES does not already cover your setup.
# DIZGE_SESSION_SECURE=1
# Defaults to `storage/app.sqlite` when omitted. Set this only to use another PDO database.
# DIZGE_DB_DSN="sqlite:/var/www/dizgephp/storage/app.sqlite"
# DIZGE_DB_DSN="mysql:host=127.0.0.1;dbname=example;charset=utf8mb4"
# DIZGE_DB_USER="example"
# DIZGE_DB_PASSWORD="change-me"
